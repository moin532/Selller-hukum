# Production Hukum API (default for Cloudhost / client machines)
NEXT_PUBLIC_API_URL=https://api.hukum-ksa.com
NEXT_PUBLIC_HUKUM_API_URL=https://api.hukum-ksa.com
HUKUM_API_URL=https://api.hukum-ksa.com

# Marketplace (static images / storefront links)
NEXT_PUBLIC_MARKETPLACE_URL=https://hukum-ksa.com
NEXT_PUBLIC_STOREFRONT_URL=https://hukum-ksa.com

# Local Backend only (optional — do NOT set on Cloudhost):
# NEXT_PUBLIC_USE_LOCAL_API=1
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
