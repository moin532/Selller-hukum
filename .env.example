# Leave NEXT_PUBLIC_API_URL empty on Cloudhost / production.
# Browser uses same-origin /api → Next.js rewrites to production Hukum API.
#
# Production API (server rewrite target):
HUKUM_API_URL=https://api.hukum-ksa.com

# Marketplace (static category images, storefront links):
NEXT_PUBLIC_MARKETPLACE_URL=https://hukum-ksa.com
NEXT_PUBLIC_STOREFRONT_URL=https://hukum-ksa.com

# Local Backend only (optional):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
